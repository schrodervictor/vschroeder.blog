---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostListItem from '../../components/PostListItem.astro';
import { getCollection } from 'astro:content';
import { getNonDraftPosts } from '../../lib/content-helpers';

const posts = getNonDraftPosts(await getCollection('posts'));

const totalBytes = posts.reduce(
  (sum, p) => sum + (p.body ? new Blob([p.body]).size : 0),
  0
);
const totalK = Math.max(1, Math.ceil(totalBytes / 1024));
---

<BaseLayout title="Posts">
  <div class="posts-listing">
    <div class="ls-prompt">
      <span class="ls-prompt-user">vschroeder@blog</span>:<span class="ls-prompt-path">~/posts</span>$ ls -lah
    </div>
    <div class="ls-total">total {totalK}</div>
    {posts.length === 0 ? (
      <p>No posts yet. Check back soon!</p>
    ) : (
      posts.map((post) => <PostListItem post={post} />)
    )}
  </div>
</BaseLayout>

<style>
  .posts-listing {
    margin-top: 1rem;
    overflow-x: auto;
    scrollbar-color: var(--accent) var(--background);
    scrollbar-width: thin;
  }

  .ls-prompt {
    color: color-mix(in srgb, var(--foreground) 70%, transparent);
    margin-bottom: 0.4rem;
  }

  .ls-prompt-user {
    color: var(--accent);
  }

  .ls-prompt-path {
    color: color-mix(in srgb, var(--foreground) 85%, transparent);
  }

  .ls-total {
    color: color-mix(in srgb, var(--foreground) 55%, transparent);
    margin-bottom: 1rem;
  }
</style>
