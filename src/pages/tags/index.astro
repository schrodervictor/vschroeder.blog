---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = (await getCollection('posts'))
  .filter(post => !post.data.draft);

const tagCounts: Record<string, number> = {};
allPosts.forEach(post => {
  post.data.tags?.forEach(tag => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

const sortedTags = Object.keys(tagCounts).sort((a, b) => tagCounts[b] - tagCounts[a] || a.localeCompare(b));
const half = Math.ceil(sortedTags.length / 2);
const leftCol = sortedTags.slice(0, half);
const rightCol = sortedTags.slice(half);
---

<BaseLayout title="Tags" description="All tags used in posts">
  <div class="tags-listing">
    <div class="grep-prompt">
      <span class="grep-user">vschroeder@blog</span>:<span class="grep-path">~/posts</span>$ grep -rc --include="*.md" tags/ | sort -t: -k2 -nr
    </div>
    <div class="grep-output">
      <div class="grep-col">
        {leftCol.map(tag => (
          <a href={`/tags/${tag}/`} class="grep-line">
            <span class="grep-tag">{tag}</span><span class="grep-sep">:</span><span class="grep-count">{tagCounts[tag]}</span>
          </a>
        ))}
      </div>
      <div class="grep-col">
        {rightCol.map(tag => (
          <a href={`/tags/${tag}/`} class="grep-line">
            <span class="grep-tag">{tag}</span><span class="grep-sep">:</span><span class="grep-count">{tagCounts[tag]}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .tags-listing {
    margin-top: 1rem;
    overflow-x: auto;
    scrollbar-color: var(--accent) var(--background);
    scrollbar-width: thin;
  }

  .grep-prompt {
    color: color-mix(in srgb, var(--foreground) 70%, transparent);
    margin-bottom: 0.8rem;
  }

  .grep-user {
    color: var(--accent);
  }

  .grep-path {
    color: color-mix(in srgb, var(--foreground) 85%, transparent);
  }

  .grep-output {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 3rem;
  }

  .grep-line {
    display: flex;
    text-decoration: none;
    padding: 2px 0;
    white-space: nowrap;
  }

  .grep-line:hover .grep-tag {
    color: var(--accent);
    background: transparent;
  }

  .grep-tag {
    color: var(--background);
    background: color-mix(in srgb, var(--accent) 60%, var(--background));
    padding: 0 3px;
    font-weight: bold;
  }

  .grep-sep {
    color: color-mix(in srgb, var(--foreground) 35%, transparent);
  }

  .grep-count {
    color: var(--accent);
    min-width: 2ch;
    text-align: right;
  }

  @media (max-width: 684px) {
    .grep-output {
      grid-template-columns: 1fr;
    }
  }
</style>
